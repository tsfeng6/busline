rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all rule denying all other access
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for user-submitted bus lines
    match /submissions/{submissionId} {
      // Anyone can query or view submission documents (so everyone can download approved routes dynamically)
      allow read: if true;

      // Anyone is allowed to submit a new custom bus line
      allow create: if request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.status == 'pending'
                    && request.resource.data.path is list
                    && request.resource.data.path.size() >= 1
                    && (request.resource.data.timestamp is int || request.resource.data.timestamp is float);

      // Allow updating or deleting existing routes (used by admins / password-authenticated flows)
      allow update: if request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 200
                    && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected' || request.resource.data.status == 'pending');

      allow delete: if true;
    }
  }
}
