{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "User submitted custom bus line to be verified by administrators",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the submission"
        },
        "name": {
          "type": "string",
          "description": "Name of the custom bus line"
        },
        "creatorNickname": {
          "type": "string",
          "description": "Creator nickname"
        },
        "city": {
          "type": "string",
          "description": "Target city name"
        },
        "district": {
          "type": "string",
          "description": "Target district or area"
        },
        "path": {
          "type": "array",
          "description": "Coordinates making up the bus route path"
        },
        "via_stops": {
          "type": "array",
          "description": "Bus stops along the line"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status of the custom bus line"
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp when submitted"
        }
      },
      "required": ["id", "name", "path", "via_stops", "status", "timestamp"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "User custom bus line submissions"
    }
  }
}
