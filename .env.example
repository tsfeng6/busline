# AMAP API (Gaode Maps)
# Required for map rendering and bus line search
VITE_AMAP_KEY="YOUR_AMAP_KEY"
VITE_AMAP_SECURITY_CODE="YOUR_AMAP_SECURITY_CODE"

DATABASE_URL="postgresql://user:password@hostname:port/database"

# 腾讯云 PostgreSQL 数据库连接字符串 (TencentDB for PostgreSQL)
# 格式: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=""
# Shared city JSON storage (server only; do not use a VITE_ prefix for credentials)
CITY_DATA_ENABLED=false
CITY_DATA_GITHUB_REPO=tsfeng6/busline
CITY_DATA_GITHUB_BRANCH=busline-data
CITY_DATA_GITHUB_TOKEN=
# Optional administrator maintenance credential (12+ characters); ordinary updates use city-scoped leases.
ADMIN_PASSWORD=

# Public frontend settings; rebuild after changing these.
VITE_CITY_DATA_ENABLED=false
# Optional read-only static endpoint (leave empty to read through the backend):
# https://raw.githubusercontent.com/tsfeng6/busline/busline-data/city-data/v1
VITE_CITY_DATA_READ_BASE_URL=

# Recommended no-permanent-server update mode (Worker -> GitHub Actions)
VITE_CITY_UPDATE_MODE=actions
VITE_CITY_UPDATE_GATEWAY_URL=

# Game accounts / leaderboards. The frontend receives only the gateway URL.
VITE_GAME_GATEWAY_URL=
# EdgeOne-only variables (do not use VITE_):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# GitHub repository Secrets: AMAP_WEB_SERVICE_KEY, CITY_UPDATE_CALLBACK_SECRET
# GitHub repository Variable: CITY_UPDATE_GATEWAY_URL (same HTTPS Worker address)
# Worker Secrets: GITHUB_DISPATCH_TOKEN, CALLBACK_SECRET, RATE_LIMIT_SALT
